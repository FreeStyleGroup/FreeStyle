{
  "name": "@freestyle/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@freestyle/shared": "*",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "axios": "^1.7.9",
    "node-cache": "^5.1.2",
    "express-rate-limit": "^7.5.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^6.9.16",
    "markdown-it": "^14.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/nodemailer": "^6.4.16",
    "@types/markdown-it": "^14.1.2",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.28.1"
  }
}
