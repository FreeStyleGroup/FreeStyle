# ════════════════════════════════════════════════════════════════
#  FreeStyle.ru — environment configuration
#  Скопировать в .env, заполнить чувствительные значения.
#  Никогда не коммитить .env в git (.gitignore это уже учитывает).
# ════════════════════════════════════════════════════════════════

# ─── Server ───
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ─── Postgres ────────────────────────────────────────────────────
# Локально: docker-compose up -d postgres  → postgres://freestyle:freestyle@localhost:5432/freestyle
# Прод (reg.ru VPS, postgres рядом в той же docker-сети):
#   postgres://freestyle:STRONG_PASSWORD@postgres:5432/freestyle?sslmode=disable
DATABASE_URL=postgres://freestyle:freestyle@localhost:5432/freestyle
DATABASE_POOL_MAX=10

# ─── JWT / Cookies ───────────────────────────────────────────────
# Сгенерировать секреты: `openssl rand -base64 48`
# Минимум 32 символа каждый. Никогда не использовать одинаковые для access и refresh.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Для прода: COOKIE_DOMAIN=.freestyle.ru, COOKIE_SECURE=true (только по HTTPS).
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ─── Bcrypt ─────────────────────────────────────────────────────
# Dev: 10 (быстро). Prod: 12 (безопаснее, но ~250мс на хеш — это OK для auth-роутов).
BCRYPT_COST=10

# ─── SMTP (для email verification + password reset) ─────────────
# Если SMTP_HOST пустой — письма уходят в консоль (dev-режим, реальная отправка не нужна).
# Рекомендованные провайдеры: SendPulse (RU-friendly), Mailgun, Yandex.Mail для бизнеса.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FreeStyle.ru <no-reply@freestyle.ru>

# ─── AI (Content Factory) ───────────────────────────────────────
# AITunnel — RU-friendly proxy на OpenAI/Anthropic/Gemini. Если пустой ключ —
# генерация идей/статей возвращает stub в дев-режиме.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_MODEL=gpt-4o-mini

# Включить cron-планировщик автопубликации (false — отключаем для тестов).
SCHEDULER_ENABLED=true

# ─── Travelpayouts ──────────────────────────────────────────────
TP_API_TOKEN=your_travelpayouts_api_token_here
TP_MARKER=304805
TP_PROJECT_ID=304805
TP_API_BASE_URL=https://api.travelpayouts.com
TP_AFFILIATE_BASE_URL=https://tp.media

# ─── Кэш / Rate-limit ───────────────────────────────────────────
CACHE_DEFAULT_TTL=900
CACHE_REFERENCE_TTL=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Локаль ─────────────────────────────────────────────────────
DEFAULT_LOCALE=ru
DEFAULT_CURRENCY=rub
